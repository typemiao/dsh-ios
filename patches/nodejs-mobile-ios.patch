+patch_host_mks() {
+  # nodejs-mobile/gyp quirk with Xcode 26: the Makefile generator leaks the
+  # iOS SDK (-isysroot <iPhoneOS.sdk> -miphoneos-version-min) into HOST-tool
+  # targets (node_js2c, mksnapshot, torque, ...). Host tools linked against
+  # the iOS SDK are iOS binaries that macOS refuses to execute (SIGKILL).
+  # Point every *.host.mk at the macOS SDK instead.
+  local mac_sdk
+  mac_sdk="$(xcrun --sdk macosx --show-sdk-path)"
+  while IFS= read -r mk; do
+    sed -i '' "s|/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/[^\"]*|$mac_sdk|g" "$mk"
+    sed -i '' "s|/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneOS.platform/Developer/SDKs/[^\"]*|$mac_sdk|g" "$mk"
+    sed -i '' 's|-miphoneos-version-min=14.0|-mmacosx-version-min=13.0|g' "$mk"
+    sed -i '' 's|-mios-simulator-version-min=14.0|-mmacosx-version-min=13.0|g' "$mk"
+  done < <(find out -name '*.host.mk' 2>/dev/null)
+}
